---
import { homeHref } from '../lib/recipes';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Handwritten family recipes, preserved as images and transcribed for reading and search.' } = Astro.props;
const home = homeHref(import.meta.env.BASE_URL);
const isPreview = import.meta.env.BASE_URL.includes('/preview/');
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<script is:inline>
			(() => {
				const cookie = document.cookie.split('; ').find((row) => row.startsWith('theme='));
				const stored = cookie?.slice('theme='.length);
				const theme =
					stored === 'light' || stored === 'dark'
						? stored
						: matchMedia('(prefers-color-scheme: dark)').matches
							? 'dark'
							: 'light';
				document.documentElement.dataset.theme = theme;
				document.documentElement.style.colorScheme = theme;
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href={`${home}favicon.svg`} />
		<link rel="icon" href={`${home}favicon.ico`} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="color-scheme" content="light dark" />
		{isPreview && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>
	</head>
	<body>
		<header>
			<p><a href={home}>Family Recipes</a></p>
			<button type="button" id="theme-toggle" aria-label="Toggle color theme">
				<span class="theme-next-dark">Dark</span>
				<span class="theme-next-light">Light</span>
			</button>
		</header>
		<slot />
	</body>
</html>

<script>
	const COOKIE = 'theme';
	const MAX_AGE = 60 * 60 * 24 * 365;

	function systemTheme(): 'light' | 'dark' {
		return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
	}

	function storedTheme(): 'light' | 'dark' | null {
		const cookie = document.cookie.split('; ').find((row) => row.startsWith(`${COOKIE}=`));
		const value = cookie?.slice(`${COOKIE}=`.length);
		return value === 'light' || value === 'dark' ? value : null;
	}

	function currentTheme(): 'light' | 'dark' {
		const applied = document.documentElement.dataset.theme;
		if (applied === 'light' || applied === 'dark') return applied;
		return storedTheme() ?? systemTheme();
	}

	function applyTheme(theme: 'light' | 'dark') {
		document.documentElement.dataset.theme = theme;
		document.documentElement.style.colorScheme = theme;

		const button = document.getElementById('theme-toggle');
		if (!button) return;
		const next = theme === 'dark' ? 'light' : 'dark';
		button.setAttribute('aria-label', `Switch to ${next} theme`);
	}

	function saveTheme(theme: 'light' | 'dark') {
		document.cookie = `${COOKIE}=${theme}; Path=/; Max-Age=${MAX_AGE}; SameSite=Lax`;
	}

	applyTheme(currentTheme());

	document.getElementById('theme-toggle')?.addEventListener('click', () => {
		const next = currentTheme() === 'dark' ? 'light' : 'dark';
		saveTheme(next);
		applyTheme(next);
	});

	matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
		if (storedTheme()) return;
		applyTheme(event.matches ? 'dark' : 'light');
	});
</script>

<style is:global>
	:root {
		color-scheme: light;
		--bg: #f4f4f1;
		--fg: #1c1c1a;
		--img-placeholder: #e8e8e8;
		--control-bg: #e8e8e4;
		--control-border: #f4f4f1;
	}

	html[data-theme='dark'] {
		color-scheme: dark;
		--bg: #1c1c1a;
		--fg: #f4f4f1;
		--img-placeholder: #2c2c2a;
		--control-bg: #4a4a46;
		--control-border: #6e6e68;
	}

	html {
		background-color: var(--bg);
		color: var(--fg);
	}

	body {
		max-width: 48rem;
		margin: 1rem auto;
		padding: 0 1rem 3rem;
	}

	header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	header p {
		margin: 1em 0;
	}

	#theme-toggle {
		font-size: 16px;
		flex-shrink: 0;
	}

	#theme-toggle .theme-next-light {
		display: none;
	}

	html[data-theme='dark'] #theme-toggle .theme-next-dark {
		display: none;
	}

	html[data-theme='dark'] #theme-toggle .theme-next-light {
		display: inline;
	}

	img {
		max-width: 100%;
		height: auto;
		background-color: var(--img-placeholder);
	}

	pre {
		white-space: pre-wrap;
	}

	input,
	select,
	textarea,
	button {
		font-size: 16px;
		color: inherit;
		background-color: var(--control-bg);
		border-color: var(--control-border);
	}

	/* iOS drops its 5px UA radius once a control is author-colored. */
	@supports (-webkit-touch-callout: none) {
		@media (pointer: coarse) {
			input,
			select,
			textarea,
			button {
				border-radius: 5px;
			}
		}
	}
</style>
