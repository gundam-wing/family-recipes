---
import { homeHref } from '../lib/recipes';

interface Props {
	title: string;
	description?: string;
	/** Absolute URL for social/OG preview image (e.g. featured photo). */
	image?: string | null;
	ogType?: 'website' | 'article';
}

const {
	title,
	description = 'Handwritten family recipes, preserved as images and transcribed for reading and search.',
	image = null,
	ogType = 'website',
} = Astro.props;
const home = homeHref(import.meta.env.BASE_URL);
const isPreview = import.meta.env.BASE_URL.includes('/preview/');
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const twitterCard = image ? 'summary_large_image' : 'summary';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${home}favicon.svg`} />
		<link rel="icon" href={`${home}favicon.ico`} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		{isPreview && <meta name="robots" content="noindex, nofollow" />}
		<title>{title}</title>

		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:site_name" content="Family Recipes" />
		{image && <meta property="og:image" content={image} />}

		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{image && <meta name="twitter:image" content={image} />}
	</head>
	<body>
		<header>
			<p><a href={home}>Family Recipes</a></p>
		</header>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--img-placeholder: #e8e8e8;
	}

	body {
		max-width: 48rem;
		margin: 1rem auto;
		padding: 0 1rem 3rem;
	}

	img {
		max-width: 100%;
		height: auto;
		background-color: var(--img-placeholder);
	}

	pre {
		white-space: pre-wrap;
	}

	input,
	select,
	textarea {
		font-size: 16px;
	}
</style>
