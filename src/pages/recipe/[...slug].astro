---
import Layout from '../../layouts/Layout.astro';
import {
	categoryLabel,
	featuredHref,
	homeHref,
	imageHref,
	loadRecipes,
	type Recipe,
} from '../../lib/recipes';

export function getStaticPaths() {
	return loadRecipes().map((recipe) => ({
		params: { slug: recipe.id },
		props: { recipe },
	}));
}

interface Props {
	recipe: Recipe;
}

const { recipe } = Astro.props;
const base = import.meta.env.BASE_URL;
const label = categoryLabel(recipe.category, recipe.subcategory);
---

<Layout title={`${recipe.title} · Family Recipes`} description={`${recipe.title} — ${label}`}>
	<main class="page shell stack-lg">
		<p>
			<a class="back-link" href={homeHref(base)}>← Index</a>
		</p>

		<article class="stack-lg">
			{
				recipe.featuredImage ? (
					<header class="recipe-hero">
						<div class="recipe-hero-media">
							<img
								src={featuredHref(base, recipe.featuredImage)}
								alt={`Prepared ${recipe.title}`}
								width="1200"
								height="900"
								fetchpriority="high"
							/>
						</div>
						<div class="recipe-hero-veil" aria-hidden="true"></div>
						<p class="recipe-kicker">
							{label}
							{recipe.pages.length > 1 ? ` · ${recipe.pages.length} pages` : ''}
						</p>
						<h1 class="recipe-heading">{recipe.title}</h1>
					</header>
				) : (
					<header class="stack">
						<p class="recipe-kicker recipe-kicker-ink">
							{label}
							{recipe.pages.length > 1 ? ` · ${recipe.pages.length} pages` : ''}
						</p>
						<h1 class="recipe-heading-plain">{recipe.title}</h1>
					</header>
				)
			}

			{
				recipe.text && (
					<section class="panel">
						<h2>Transcript</h2>
						<pre>{recipe.text}</pre>
					</section>
				)
			}

			<section class="panel">
				<h2>{recipe.pages.length > 1 ? 'Original cards' : 'Original card'}</h2>
				<div class="card-gallery">
					{
						recipe.pages.map((page) => (
							<figure class="scan-figure">
								<img
									src={imageHref(base, page.file)}
									alt={`${recipe.title}${recipe.pages.length > 1 ? `, page ${page.page}` : ''}`}
									loading="lazy"
								/>
								{recipe.pages.length > 1 && <figcaption>Page {page.page}</figcaption>}
							</figure>
						))
					}
				</div>
			</section>
		</article>
	</main>
</Layout>
